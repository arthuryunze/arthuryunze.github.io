#!/bin/bash

# 定义目录和日期
posts_dir="_posts"
date=$(date +%Y-%m-%d)

# 检查参数
if [ -z "$1" ]; then
  echo "❌ 错误：请提供文章标题，例如 ./newpost '我的新文章'"
  exit 1
fi

# 处理标题（空格转连字符，转小写）
title=$(echo "$1" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
filename="$date-$title.md"

# 创建目录（如果不存在）
mkdir -p "$posts_dir"

# 生成文件内容
# echo "---
# title: \"$1\"
# date: $date
# ---
# " > "$posts_dir/$filename"

echo "# $1
" > "$posts_dir/$filename"

echo "✅ 文章已创建：$posts_dir/$filename"
code --goto "$posts_dir/$filename:3:0"